{
  "name": "intentledger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:ui",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:pages": "node --test tests/pages.test.mjs",
    "test:unit": "node --test tests/*.test.ts",
    "test:ui": "node scripts/test-ui.mjs",
    "format": "prettier --write src tests scripts index.html *.json *.ts .github/workflows/deploy.yml",
    "format:check": "prettier --check src tests scripts index.html *.json *.ts .github/workflows/deploy.yml"
  },
  "dependencies": {
    "lucide-react": "0.544.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "24.0.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "4.6.0",
    "esbuild": "^0.25.11",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.10"
  }
}
